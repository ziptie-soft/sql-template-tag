{
  "$schema": "http://json.schemastore.org/package.json",
  "name": "@ziptie-soft/sql-template-tag",
  "version": "5.2.2",
  "description": "ES2015 tagged template string for preparing SQL statements, works with `pg`, `mysql`, `sqlite` and `oracledb`. Ships CommonJS and ESM.",
  "keywords": [
    "commonjs",
    "esm",
    "mysql",
    "oracle",
    "oracledb",
    "pg",
    "postgres",
    "sql",
    "sqlite",
    "string",
    "tag",
    "template"
  ],
  "homepage": "https://github.com/ziptie-soft/sql-template-tag#readme",
  "bugs": {
    "url": "https://github.com/ziptie-soft/sql-template-tag/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Blake Embrey",
    "email": "hello@blakeembrey.com",
    "url": "http://blakeembrey.me"
  },
  "contributors": [
    {
      "name": "m03geek",
      "url": "https://github.com/SkeLLLa"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziptie-soft/sql-template-tag.git"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./pinot": {
      "import": {
        "types": "./dist/pinot.d.mts",
        "default": "./dist/pinot.mjs"
      },
      "require": {
        "types": "./dist/dialects/pinot.d.ts",
        "default": "./dist/dialects/pinot.js"
      }
    },
    "./snowflake": {
      "import": {
        "types": "./dist/snowflake.d.mts",
        "default": "./dist/snowflake.mjs"
      },
      "require": {
        "types": "./dist/dialects/snowflake.d.ts",
        "default": "./dist/dialects/snowflake.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "benchmark": "tsx benchmarks/index.ts",
    "benchmark:dialects": "tsx benchmarks/dialects.ts",
    "build": "pnpm run build:clean && pnpm run build:node && pnpm run build:docs && pnpm run build:format",
    "build:clean": "rm -rf dist",
    "build:docs": "api-extractor run -l && api-documenter markdown -i ./temp -o ./docs/api",
    "build:esm": "cp esm/*.mjs esm/*.d.mts dist/",
    "build:format": "oxfmt",
    "build:node": "tsc -p tsconfig.build.json && pnpm run build:esm",
    "lint": "pnpm run lint:codestyle && pnpm run lint:packages",
    "lint:codestyle": "oxlint && oxfmt --check",
    "lint:dist": "publint --strict && attw --pack . --profile node16",
    "lint:packages": "pnpm audit --prod --audit-level=high",
    "release": "semantic-release",
    "test": "pnpm run lint && pnpm run test:unit && pnpm run test:dual",
    "test:dual": "pnpm run build:clean && pnpm run build:node && node test/smoke/smoke.cjs && node test/smoke/smoke.mjs && pnpm run lint:dist",
    "test:unit": "pnpm run test:build && node --no-warnings --experimental-test-coverage --test-coverage-include='.test-build/src/**' --test-coverage-lines=99 --test-coverage-branches=95 --test-coverage-functions=100 --test-reporter=lcov --test-reporter-destination=lcov.info --test '.test-build/test/**/*.test.js'",
    "test:unit:local": "pnpm run test:build && node --no-warnings --experimental-test-coverage --test-coverage-include='.test-build/src/**' --test-coverage-lines=99 --test-coverage-branches=95 --test-coverage-functions=100 --test '.test-build/test/**/*.test.js'",
    "test:build": "rm -rf .test-build && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@microsoft/api-documenter": "^7.30.20",
    "@microsoft/api-extractor": "^7.60.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tsconfig/node-lts": "^26.0.1",
    "@tsconfig/strictest": "^2.0.9",
    "@types/node": "^26.6.6",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "fast-check": "^4.11.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "publint": "^0.3.25",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.11.0"
    }
  },
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.16.1"
}
